&GLOBAL
  PROJECT H2O
  RUN_TYPE GEO_OPT
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS ATOMIC
    &END SCF
  &END DFT

  &SUBSYS
    &CELL
      ABC 10.0 10.0 10.0
    &END CELL

    &COORD
    UNIT angstrom
    	O -2.304128885269165 3.024470567703247 3.1757349461258855e-06
	H -1.387363989509943 2.7787770981676574 0.04095219625292504
	H -2.723218283710498 2.5653969824624117 -0.718408612029176
    &END COORD

    &KIND H
      ELEMENT H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND
    &KIND O
	ELEMENT O
	BASIS_SET DZVP-MOLOPT-SR-GTH
	POTENTIAL GTH-PBE
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

