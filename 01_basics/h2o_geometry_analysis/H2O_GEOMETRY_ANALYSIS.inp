&GLOBAL
  PROJECT H2O_GEOMETRY_ANALYSIS
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS ATOMIC
    &END SCF
  &END DFT

  &SUBSYS
    &CELL
      ABC 10.0 10.0 10.0
    &END CELL

    &COORD
      UNIT ANGSTROM
      O  0.0450214028   0.0381960502   0.0397644093
      H  1.0095540038  -0.0287362749  -0.0420629578
      H -0.2920563808  -0.4615304990  -0.7204050179
    &END COORD

    &KIND H
      ELEMENT H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &KIND O
      ELEMENT O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND

    &PRINT
      &STRUCTURE_DATA
	DISTANCE 1 2
        DISTANCE 1 3
        ANGLE 2 1 3
      &END STRUCTURE_DATA
    &END PRINT

  &END SUBSYS

&END FORCE_EVAL
