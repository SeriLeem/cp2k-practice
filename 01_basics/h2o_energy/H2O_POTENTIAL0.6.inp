&GLOBAL
  PROJECT H2O_POTENTIAL
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep

  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME POTENTIAL

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC

    &SCF
      SCF_GUESS ATOMIC
    &END SCF
  &END DFT

  &SUBSYS
    &CELL
      ABC 10.0 10.0 10.0
    &END CELL

    &COORD
    UNIT ANGSTROM
 	O 0.0 0.0 0.0
H 0.6 0.0 0.0
	H -0.4191 -0.4591 -0.7184
    &END COORD

    &KIND H
      ELEMENT H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE
    &END KIND
    &KIND O
		  ELEMENT O
		  BASIS_SET DZVP-MOLOPT-SR-GTH
		  POTENTIAL GTH-PBE
		&END KIND
  &END SUBSYS
&END FORCE_EVAL